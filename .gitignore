# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Flutter plugin deps manifest (regenerated on pub get)
.flutter-plugins

# Env + secrets
.env
.env.*

# Model files — too large for git. See assets/models/README.md.
assets/models/*.onnx
assets/models/*.bin
assets/models/*.task
assets/models/*.gguf
assets/models/*.tflite
assets/models/parakeet/

# Rust build output
/rust/**/target/
/rust_builder/cargokit/**/Cargo.lock

# Generated code (committed is optional; safer to regenerate locally)
lib/**/*.g.dart
lib/**/*.freezed.dart
lib/**/*.drift.dart
lib/objectbox.g.dart
lib/objectbox-model.json

# Test fixtures (large audio)
assets/fixtures/*.wav
assets/fixtures/*.mp3
assets/fixtures/*.m4a

